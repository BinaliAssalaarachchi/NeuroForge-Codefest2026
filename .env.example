# OpenRouter API Keys (comma-separated for key rotation across free-tier accounts)
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2

# OpenRouter LLM Model (Free Tier)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Google AI Studio Gemini (active LLM provider)
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash

# Voyage AI API Key
VOYAGE_API_KEY=pa-4VEIVqqc4aA6ZQtDWsqetKX-eOfSSBE_4va0P4OpduT
VOYAGE_EMBED_MODEL=voyage-4-lite

# Data & Storage Directories
CHROMA_PERSIST_DIR=./data/chroma_db
BM25_PERSIST_PATH=./data/bm25_index.pkl
CACHE_DIR=./.cache
LOGS_DIR=./logs
CORPUS_DIR=./corpus
